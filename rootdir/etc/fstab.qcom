# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

#<src>                                     <mnt_point>     <type>  <mnt_flags and options>                                             <fs_mgr_flags>

#### keep in mind: the order here is the order how it gets processed!

# early / first stage mounts
/dev/block/bootdevice/by-name/system       /system         ext4    ro,barrier=1,noatime,user_xattr,discard                                        wait

#/dev/block/bootdevice/by-name/cache        /cache          ext4    nosuid,nodev,barrier=1,noatime,noauto_da_alloc,errors=continue,journal_async_commit,user_xattr,discard      wait,check
/dev/block/bootdevice/by-name/cache        /cache          f2fs    rw,nosuid,nodev,noatime,nodiratime,inline_xattr,discard                        wait,check

#note: the following are (in A9) early mounted by the kernel DT!
/dev/block/bootdevice/by-name/modem        /firmware       vfat    ro,uid=1000,gid=1026,dmask=227,fmask=337                                       wait,check
/dev/block/bootdevice/by-name/persist      /persist        ext4    nosuid,nodev,barrier=1,data=ordered,nodelalloc,errors=panic,user_xattr         wait,notrim

# late mounts
# note: f2fs will not mount with errors=panic and/or barrier=1
# no discard bc: https://asalor.blogspot.com/2011/08/trim-dm-crypt-problems.html
#/dev/block/bootdevice/by-name/userdata     /data           ext4    nosuid,nodev,barrier=1,noatime,noauto_da_alloc,errors=continue,journal_async_commit,user_xattr      wait,forceencrypt=/dev/block/bootdevice/by-name/encrypt,latemount
/dev/block/bootdevice/by-name/userdata     /data           f2fs    noatime,nosuid,nodev,nodiratime,inline_xattr                                                        wait,check,forceencrypt=/dev/block/bootdevice/by-name/encrypt,latemount

# regular mounts
/dev/block/bootdevice/by-name/sns          /sns            ext4    nosuid,nodev,barrier=1,noatime,noauto_da_alloc,errors=continue,user_xattr      wait,notrim,check,latemount
/dev/block/bootdevice/by-name/drm          /persist-lg     ext4    nosuid,nodev,barrier=1,noatime,noauto_da_alloc,errors=continue,user_xattr      wait,notrim,check,latemount
/dev/block/bootdevice/by-name/mpt          /mpt            ext4    nosuid,nodev,barrier=1,noatime,noauto_da_alloc,errors=continue,user_xattr      wait,notrim,check,latemount

# definitons required but not containing a regular file system
/dev/block/bootdevice/by-name/grow         /misc           emmc    defaults                                                            defaults
/dev/block/bootdevice/by-name/persistent   /persistent     emmc    defaults                                                            defaults
/dev/block/bootdevice/by-name/boot         /boot           emmc    defaults                                                            recoveryonly
/dev/block/bootdevice/by-name/recovery     /recovery       emmc    defaults                                                            recoveryonly
 
### NOTE:
# /cust + /carrier are handled within device/lge/g4 by a condition depending on the device model
###

# vold managed (sdcard|otg)
/devices/soc.0/f98a4900.sdhci/mmc_host*        auto        auto    defaults        voldmanaged=sdcard1:auto,encryptable=/dev/block/bootdevice/by-name/encrypt
/devices/soc.0/f9200000.ssusb/f9200000.dwc3/xhci-hcd.0.auto/usb*        auto        auto    defaults        voldmanaged=usb:auto
