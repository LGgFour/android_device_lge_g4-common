# accessing /vendor/firmware/BCM4335_BCM4339_003.001.009.0117.0620_LGE_P1_EU.hcd
allow hal_bluetooth_default firmware_file:dir { open read search };
allow hal_bluetooth_default firmware_file:file { open read getattr map };

# FIXME:
# the following is a WORKAROUND, allowing to (also) write to /sys/class/rfkill/rfkill0/state.
# the global system policy defines /sys/class/rfkill/rfkill0/state with u:object_r:sysfs_bluetooth_writable:s0
# which is the correct approach, but unfortunately in practice this does not work on the G4 though, unclear why!
# instead we allow access to sysfs instead, which is far from ideal, obviously:
allow hal_bluetooth_default sysfs:file { write };
